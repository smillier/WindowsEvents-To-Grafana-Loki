// config-collector.alloy
// Runs on the WEC collector only. Reads ForwardedEvents (all subscriptions)
// and ships to Loki with computer, event_id, channel and level as labels.

// ---------------------------------------------------------------------------
// Source: single channel holding everything forwarded by the subscriptions
// ---------------------------------------------------------------------------

loki.source.windowsevent "forwarded" {
  eventlog_name          = "ForwardedEvents"
  xpath_query            = "*"
  bookmark_path          = "C:\\ProgramData\\GrafanaLabs\\Alloy\\data\\forwardedevents.bookmark"
  poll_interval          = "3s"
  use_incoming_timestamp = true
  labels = {
    job = "windows-eventlog",
  }
  forward_to = [loki.process.windows.receiver]
}

// ---------------------------------------------------------------------------
// Processing
// ---------------------------------------------------------------------------

loki.process "windows" {
  // Core fields (computer = ORIGINATING host, not the collector)
  stage.json {
    expressions = {
      computer = "computer",
      channel  = "channel",
      event_id = "event_id",
      level    = "levelText",
      source   = "source",
    }
  }

  // Normalize computer: strip the domain suffix, then lowercase
  
  stage.replace {
    source     = "computer"
    expression = `^[^.]+(\..+)$`
  }

  stage.template {
    source   = "computer"
    template = "{{ ToLower .Value }}"
  }

  // Keep your previous channel label values
  stage.replace {
    source     = "channel"
    expression = `^(Directory Service)$`
    replace    = "Directory_Services"
  }

  stage.replace {
    source     = "channel"
    expression = `^(Microsoft-Windows-SMBServer/Audit)$`
    replace    = "SMBServer"
  }

  // Indexed labels: these are what you filter on in the stream selector
  stage.labels {
    values = {
      computer = "",
      event_id = "",
      channel  = "",
      level    = "",
      source   = "",
    }
  }

  // Nested EventData properties (carried over unchanged from your config).
  // Verify against a real log line in Explore if these come out empty.
  stage.json {
    expressions = {
      target_user  = "eventData.TargetUserName",
      subject_user = "eventData.SubjectUserName",
      ip_address   = "eventData.IpAddress",
      logon_type   = "eventData.LogonType",
      workstation  = "eventData.WorkstationName",
      process_name = "eventData.NewProcessName",
      service_name = "eventData.ServiceName",
      object_name  = "eventData.ObjectName",
    }
  }

  stage.structured_metadata {
    values = {
      target_user  = "",
      subject_user = "",
      ip_address   = "",
      logon_type   = "",
      workstation  = "",
      process_name = "",
      service_name = "",
      object_name  = "",
    }
  }

  forward_to = [loki.write.endpoint.receiver]
}

// ---------------------------------------------------------------------------
// Loki endpoint
// ---------------------------------------------------------------------------



loki.write "endpoint" {
  endpoint {
        url = "http://loki.home.local:3100/loki/api/v1/push"
	tls_config {
            insecure_skip_verify = true
        }
	tenant_id = "tenant1"
    }
}

